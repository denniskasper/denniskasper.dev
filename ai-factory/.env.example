# /opt/ai-factory/.env.example
#
# Copy to .env and fill in all values before starting the stack:
#   cp .env.example .env && chmod 600 .env
#
# Generate passwords:
#   openssl rand -base64 32
#
# IMPORTANT: .env must NEVER be committed to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Claude / Anthropic
# Create a SEPARATE key for the factory: https://console.anthropic.com/
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---------------------------------------------------------------------------
# Telegram
# Get token from @BotFather. Find your user ID via @userinfobot.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=50mb

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=aifactory
POSTGRES_USER=aifactory
POSTGRES_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Sandbox limits (constrained VPS — run 1 sandbox at a time)
#
# Memory math: 1 agent x 384m = 384m (fits in ~500MB sandbox headroom)
# Increase these ONLY after upgrading VPS to 8+ GB RAM.
# ---------------------------------------------------------------------------
OPENCLAW_MAX_CONCURRENT_AGENTS=1
OPENCLAW_AGENT_MEMORY_LIMIT=384m
OPENCLAW_AGENT_CPU_LIMIT=0.5
